{
	"name": "starterx4.github.io",
	"version": "0.1.0",
	"private": true,
	"homepage": "https://starterx4.github.io/",
	"dependencies": {
		"@reduxjs/toolkit": "2.6.1",
		"@types/react": "19.0.11",
		"@types/react-dom": "19.0.4",
		"gh-pages": "^6.3.0",
		"primeicons": "7.0.0",
		"primereact": "10.9.3",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-redux": "9.2.0",
		"react-scripts": "^5.0.1",
		"redux-persist": "^6.0.0",
		"typescript": "^5.9.2"
	},
	"scripts": {
		"start": "react-scripts start",
		"build": "cross-env GENERATE_SOURCEMAP=false react-scripts build && shx cp build/index.html build/404.html",
		"build:analyze": "cross-env GENERATE_SOURCEMAP=false react-scripts build && webpack-bundle-analyzer build/static/js/*.js",
		"build:analyze:dev": "npm run build:dev && npx webpack-bundle-analyzer build/static/js/*.js",
		"build:dev": "cross-env GENERATE_SOURCEMAP=true react-scripts build && shx cp build/index.html build/404.html",
		"test": "react-scripts test",
		"eject": "react-scripts eject",
		"predeploy": "pnpm run build",
		"deploy": "gh-pages -d build",
		"runBoth": "run-p server start",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"type-check": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"clean": "rm -rf node_modules pnpm-lock.yaml",
		"reinstall": "pnpm install",
		"performance:analyze": "pnpm run build:analyze",
		"performance:check": "pnpm run build && npx lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all",
			"firefox 52",
			"chrome 48"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"cross-env": "10.0.0",
		"react-router-dom": "7.3.0",
		"shx": "^0.4.0",
		"web-vitals": "5.1.0",
		"webpack-bundle-analyzer": "4.10.2"
	},
	"prettier": {
		"trailingComma": "es5",
		"tabWidth": 4,
		"semi": true,
		"singleQuote": true,
		"indent_size": 2,
		"max_line_length": 144
	}
}
