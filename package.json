{
	"name": "starterx4.github.io",
	"version": "0.1.0",
	"private": true,
	"homepage": "https://starterx4.github.io/",
	"dependencies": {
		"@preact/signals": "2.3.2",
		"gh-pages": "^6.3.0",
		"preact": "10.27.2",
		"primereact": "10.9.3",
		"typescript": "^5.9.3",
		"wouter": "3.7.1"
	},
	"scripts": {
		"start": "vite",
		"build": "vite build && shx cp build/index.html build/404.html",
		"preview": "vite preview",
		"build:analyze": "vite build && npx vite-bundle-visualizer",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"type-check": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"clean": "rm -rf node_modules pnpm-lock.yaml",
		"reinstall": "pnpm install",
		"predeploy": "pnpm run build",
		"deploy": "gh-pages -d build"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all",
			"firefox 52",
			"chrome 48"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@preact/preset-vite": "2.10.2",
		"@typescript-eslint/eslint-plugin": "8.46.2",
		"@typescript-eslint/parser": "8.46.2",
		"shx": "^0.4.0",
		"vite": "7.1.11",
		"vite-bundle-visualizer": "1.2.1",
		"web-vitals": "5.1.0"
	},
	"prettier": {
		"trailingComma": "es5",
		"tabWidth": 4,
		"semi": true,
		"singleQuote": true,
		"indent_size": 2,
		"max_line_length": 144
	}
}
